# Public site URL — used for metadata and OG tags.
NEXT_PUBLIC_SITE_URL=https://sponsor.example.com

# Supabase. Without these the site still runs, but views, the visitor ticker
# and enquiries are kept in process memory and vanish on redeploy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salt for the visitor hash. Any long random string; never store raw IPs.
VISITOR_SALT=

# Resend — without these an enquiry is still saved, just not emailed.
RESEND_API_KEY=
ENQUIRY_FROM="Sponsor my trisuit <sponsor@yourdomain.com>"

# Password for /admin.
ADMIN_PASSWORD=
